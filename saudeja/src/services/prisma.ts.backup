// ARQUIVO ANTIGO - BACKUP
// Este arquivo foi substituído por prismaClient.ts

import { PrismaClient } from '@prisma/client';
import { HealthPost, Vaccine } from '../types';

export const prismaMock = {
  user: {
    findUnique: async (args: any) => {
      // Mock de autenticação
      if (args.where.cpf === '12345678909') {
        return { id: 'mock-user-id', cpf: '12345678909', password: 'hashed_password' };
      }
      return null;
    },
  },
  vaccine: {
    findMany: async () => {
      const { vaccinesData } = await import('./database');
      return vaccinesData as Vaccine[];
    },
    findUnique: async (args: any) => {
      const { vaccinesData } = await import('./database');
      return vaccinesData.find(v => v.id === args.where.id) as Vaccine | undefined;
    },
  },
  healthPost: {
    findMany: async () => {
      const { healthPostsData } = await import('./database');
      return healthPostsData as HealthPost[];
    },
  },
};

// Exportamos o mock para que o serviço de dados possa utilizá-lo
export default prismaMock;
